[Unit]
Description=ReXgen WiFi Dashboard Service
After=wifi-manager.service network.target
Requires=wifi-manager.service

[Service]
Type=simple
ExecStart=/opt/influx/netservices/bin/netservices-dashboard
WorkingDirectory=/opt/influx/netservices
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
