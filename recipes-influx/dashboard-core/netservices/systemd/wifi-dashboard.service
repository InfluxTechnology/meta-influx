[Unit]
Description=ReXgen WiFi Dashboard Service
After=wifi-manager.service network.target
Requires=wifi-manager.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/influx/netservices/dashboard/app.py
WorkingDirectory=/opt/influx/netservices/dashboard
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

# Security hardening
NoNewPrivileges=false
ProtectSystem=false
ProtectHome=false

[Install]
WantedBy=multi-user.target
