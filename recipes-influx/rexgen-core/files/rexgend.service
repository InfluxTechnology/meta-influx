[Unit]
Description=Rexgen Daemon
After=network.target autostart.service
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/home/root/rexusb/rexgend

Restart=on-failure
RestartSec=1
StartLimitBurst=0
StartLimitIntervalSec=0
TimeoutStartSec=0
TimeoutStopSec=0
WatchdogSec=0

KillSignal=SIGINT
SendSIGHUP=no
KillMode=process

LimitNOFILE=infinity
LimitNPROC=infinity
LimitCORE=infinity
LimitAS=infinity
LimitRSS=infinity
LimitSTACK=infinity
LimitMEMLOCK=infinity
LimitCPU=infinity
LimitDATA=infinity

CPUAccounting=no
MemoryAccounting=no
TasksAccounting=no
IOAccounting=no

Nice=-10

OOMScoreAdjust=-1000

NoNewPrivileges=no
PrivateTmp=no

User=root

StandardInput=null
StandardOutput=journal
StandardError=journal
TTYPath=

[Install]
WantedBy=multi-user.target