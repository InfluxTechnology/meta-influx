
WKS_FILE = "influx-image-base.wks.in" 
IMAGE_FSTYPES = "wic"

IMAGE_INSTALL:append = " ppp "
IMAGE_INSTALL:append = " git "
IMAGE_INSTALL:append = " rsync "
IMAGE_INSTALL:append = " curl "
IMAGE_INSTALL:append = " cronie "	
IMAGE_INSTALL:append = " minicom "
IMAGE_INSTALL:append = " wvdial "	
IMAGE_INSTALL:append = " python3-pyserial python3-pyserial-asyncio python3-pip"
IMAGE_INSTALL:append = " htop "
IMAGE_INSTALL:append = " mc "
IMAGE_INSTALL:append = " tzdata "

# Influx RexGen support
IMAGE_INSTALL:append = " rexgen-core "

# Influx WIFI support
IMAGE_INSTALL:append = " wlan-manager "

INFLUX_VERSION="1.0"
INFLUX_RELEASE="sdk.${INFLUX_VERSION}"
